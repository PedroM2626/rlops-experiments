<?xml version="1.0"?>
<!--
  Humanoid URDF for Parkour RL Agent  (v2 - corrected orientation)
  Height: ~1.70 m   Mass: ~70 kg

  Coordinate convention: Z-up, X-forward, Y-left
  The humanoid FACES the +X direction.

  Leg/arm separation is along **Y** (left = +Y, right = -Y).
  Joint axes:
    - Hips, knees, ankles: rotate around Y → legs swing in XZ plane (forward/back) ✓
    - Shoulders, elbows:   rotate around Y → arms swing in XZ plane (forward/back) ✓

  Joint order (10 revolute DoFs):
    0  left_shoulder   Y-axis rotation, shoulder at +Y side of torso
    1  left_elbow      Y-axis rotation
    2  right_shoulder  Y-axis rotation, shoulder at -Y side of torso
    3  right_elbow     Y-axis rotation
    4  left_hip        Y-axis rotation, hip at +Y side of pelvis
    5  left_knee       Y-axis rotation
    6  left_ankle      Y-axis rotation
    7  right_hip       Y-axis rotation, hip at -Y side of pelvis
    8  right_knee      Y-axis rotation
    9  right_ankle     Y-axis rotation
-->
<robot name="humanoid">

  <!-- ===================== MATERIALS ===================== -->
  <material name="blue">   <color rgba="0.15 0.55 1.00 1.0"/> </material>
  <material name="gray">   <color rgba="0.55 0.55 0.55 1.0"/> </material>
  <material name="dark">   <color rgba="0.20 0.20 0.25 1.0"/> </material>
  <material name="skin">   <color rgba="0.90 0.70 0.55 1.0"/> </material>
  <material name="white">  <color rgba="0.95 0.95 0.95 1.0"/> </material>

  <!-- ===================== ROOT: TORSO ===================== -->
  <!-- Box: X=depth(front-back)=0.18, Y=width(left-right)=0.28, Z=height=0.65 -->
  <link name="torso">
    <inertial>
      <mass value="25.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.30" ixy="0" ixz="0"
               iyy="0.20" iyz="0" izz="0.15"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.18 0.28 0.65"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.18 0.28 0.65"/></geometry>
    </collision>
  </link>

  <!-- HEAD -->
  <link name="head">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.04" ixy="0" ixz="0"
               iyy="0.04" iyz="0" izz="0.04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.13"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.13"/></geometry>
    </collision>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="torso"/>
    <child  link="head"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LEFT ARM (left = +Y side) ===================== -->
  <link name="upper_arm_L">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <inertia ixx="0.014" ixy="0" ixz="0"
               iyy="0.014" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.24"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.24"/></geometry>
    </collision>
  </link>

  <joint name="left_shoulder" type="revolute">
    <parent link="torso"/>
    <child  link="upper_arm_L"/>
    <!-- +Y side of torso, upper quarter -->
    <origin xyz="0 0.19 0.25" rpy="0 0 0"/>
    <!-- Rotate around Y → arm swings forward/back in XZ plane -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="60" velocity="6"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <link name="lower_arm_L">
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.007" ixy="0" ixz="0"
               iyy="0.007" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.22"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.22"/></geometry>
    </collision>
  </link>

  <joint name="left_elbow" type="revolute">
    <parent link="upper_arm_L"/>
    <child  link="lower_arm_L"/>
    <origin xyz="0 0 -0.24" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.27" effort="40" velocity="8"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- ===================== RIGHT ARM (right = -Y side) ===================== -->
  <link name="upper_arm_R">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <inertia ixx="0.014" ixy="0" ixz="0"
               iyy="0.014" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.24"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.24"/></geometry>
    </collision>
  </link>

  <joint name="right_shoulder" type="revolute">
    <parent link="torso"/>
    <child  link="upper_arm_R"/>
    <!-- -Y side of torso -->
    <origin xyz="0 -0.19 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="60" velocity="6"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <link name="lower_arm_R">
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <inertia ixx="0.007" ixy="0" ixz="0"
               iyy="0.007" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.22"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.11" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.22"/></geometry>
    </collision>
  </link>

  <joint name="right_elbow" type="revolute">
    <parent link="upper_arm_R"/>
    <child  link="lower_arm_R"/>
    <origin xyz="0 0 -0.24" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.27" effort="40" velocity="8"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- ===================== LEFT LEG (left = +Y side) ===================== -->
  <link name="thigh_L">
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <inertia ixx="0.10" ixy="0" ixz="0"
               iyy="0.10" iyz="0" izz="0.012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.40"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.40"/></geometry>
    </collision>
  </link>

  <joint name="left_hip" type="revolute">
    <parent link="torso"/>
    <child  link="thigh_L"/>
    <!-- +Y side of pelvis BOTTOM -->
    <origin xyz="0 0.10 -0.30" rpy="0 0 0"/>
    <!-- Y-axis: leg swings in XZ plane (forward/back) -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.05" upper="1.05" effort="120" velocity="5"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="shin_L">
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <inertia ixx="0.046" ixy="0" ixz="0"
               iyy="0.046" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.40"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.40"/></geometry>
    </collision>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="thigh_L"/>
    <child  link="shin_L"/>
    <origin xyz="0 0 -0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.09" effort="100" velocity="8"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="foot_L">
    <inertial>
      <mass value="1.5"/>
      <!-- Foot extends forward (+X) from ankle -->
      <origin xyz="0.08 0 -0.03" rpy="0 0 0"/>
      <inertia ixx="0.004" ixy="0" ixz="0"
               iyy="0.004" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0.08 0 -0.03" rpy="0 0 0"/>
      <!-- X=length(toe), Y=width, Z=height -->
      <geometry><box size="0.26 0.10 0.05"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.08 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.26 0.10 0.05"/></geometry>
    </collision>
  </link>

  <joint name="left_ankle" type="revolute">
    <parent link="shin_L"/>
    <child  link="foot_L"/>
    <origin xyz="0 0 -0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.70" upper="0.70" effort="60" velocity="8"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- ===================== RIGHT LEG (right = -Y side) ===================== -->
  <link name="thigh_R">
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <inertia ixx="0.10" ixy="0" ixz="0"
               iyy="0.10" iyz="0" izz="0.012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.40"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.40"/></geometry>
    </collision>
  </link>

  <joint name="right_hip" type="revolute">
    <parent link="torso"/>
    <child  link="thigh_R"/>
    <!-- -Y side of pelvis BOTTOM -->
    <origin xyz="0 -0.10 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.05" upper="1.05" effort="120" velocity="5"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="shin_R">
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <inertia ixx="0.046" ixy="0" ixz="0"
               iyy="0.046" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.40"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.40"/></geometry>
    </collision>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="thigh_R"/>
    <child  link="shin_R"/>
    <origin xyz="0 0 -0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.09" effort="100" velocity="8"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="foot_R">
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0.08 0 -0.03" rpy="0 0 0"/>
      <inertia ixx="0.004" ixy="0" ixz="0"
               iyy="0.004" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0.08 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.26 0.10 0.05"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.08 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.26 0.10 0.05"/></geometry>
    </collision>
  </link>

  <joint name="right_ankle" type="revolute">
    <parent link="shin_R"/>
    <child  link="foot_R"/>
    <origin xyz="0 0 -0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.70" upper="0.70" effort="60" velocity="8"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

</robot>
